# Multi-stage Dockerfile for OrderFlow .NET 9 Microservices
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /app

# Copy Solution and Project files
COPY Directory.Build.props ./
COPY nuget.config ./
COPY *.sln ./
COPY src/BuildingBlocks/ src/BuildingBlocks/
COPY src/Services/ src/Services/

# Build and Publish
ARG SERVICE_PATH
ARG SERVICE_PROJECT

RUN dotnet restore $SERVICE_PATH/$SERVICE_PROJECT.csproj
RUN dotnet publish $SERVICE_PATH/$SERVICE_PROJECT.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet"]
